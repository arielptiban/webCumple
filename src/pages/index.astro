---
const recuerdos = [
  { foto: "/fotos/recuerdo-1.jpg", texto: "Uno de mis momentos favoritos" },
  { foto: "/fotos/recuerdo-2.jpg", texto: "Contigo, siempre" },
  { foto: "/fotos/recuerdo-3.jpg", texto: "Un recuerdo para siempre" },
];

const galeriaExtra = [
  { foto: "/fotos/recuerdo-1.jpg", texto: "Tú y yo" },
  { foto: "/fotos/recuerdo-2.jpg", texto: "Mi lugar favorito" },
  { foto: "/fotos/recuerdo-3.jpg", texto: "Siempre nosotros" },
  { foto: "/fotos/historia-1.jpg", texto: "Una aventura más" },
  { foto: "/fotos/historia-2.jpg", texto: "Momentos bonitos" },
  { foto: "/fotos/historia-3.jpg", texto: "Te elegiría otra vez" },
];

const deseos = [
  {
    titulo: "Que nunca dejes de soñar",
    texto:
      "Porque mereces cumplir cada uno de esos sueños que llevas en el corazón.",
  },
  {
    titulo: "Que la vida te sorprenda",
    texto:
      "Con momentos hermosos, personas buenas y muchísimas razones para sonreír.",
  },
  {
    titulo: "Que seas muy feliz",
    texto: "Hoy, mañana y todos los días que están por venir.",
  },
];

const razones = [
  "Tu sonrisa, que puede alegrar incluso mis días más difíciles.",
  "La manera tan bonita que tienes de ver la vida.",
  "Cómo conviertes los momentos sencillos en recuerdos especiales.",
  "Tu forma de querer y de cuidar a quienes amas.",
  "Todas esas pequeñas cosas que te hacen ser tú.",
  "Porque a tu lado puedo ser yo mismo.",
];

const carta = [
  "Mi amor:",
  "Hoy es un día muy especial, porque celebramos algo que para mí es inmensamente importante: tu vida.",
  "Quisiera poder regalarte todas las cosas bonitas del mundo, pero por ahora quiero regalarte un pedacito de lo que siento por ti.",
  "Gracias por cada sonrisa, por cada abrazo, por nuestras conversaciones, nuestras aventuras y todos esos pequeños momentos que se convierten en mis recuerdos favoritos.",
  "Deseo que este nuevo año de tu vida esté lleno de felicidad, salud, amor, nuevas experiencias y sueños cumplidos.",
  "Y si la vida me lo permite, quiero seguir estando a tu lado para celebrar tus logros, acompañarte en los días difíciles y seguir construyendo recuerdos contigo.",
  "Feliz cumpleaños, mi amor. Te amo muchísimo. ♡",
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#faf5ed" />
    <meta
      name="description"
      content="Un pequeño regalo de cumpleaños hecho con mucho amor."
    />
    <title>Feliz cumpleaños, mi amor ♡</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <audio id="musica" src="/audio/cancion.mp3" preload="auto" autoplay loop
    ></audio>

    <section id="inicio" class="page welcome active-page">
      <img
        class="welcome-image"
        src="/fotos/hero.jpg"
        alt="Nuestro momento especial"
        fetchpriority="high"
      />
      <div class="welcome-overlay"></div>

      <div class="welcome-content">
        <span class="eyebrow light">UN REGALITO HECHO PARA TI</span>
        <div class="welcome-heart">♡</div>

        <h1>
          Feliz<br />
          cumpleaños,<br />
          <em>mi amor</em>
        </h1>

        <p>
          Porque un día tan especial como hoy merece algo hecho con todo mi
          corazón.
        </p>

        <button id="startBtn" class="btn btn-cream" type="button">
          Abrir mi sorpresa ♡
        </button>

        <span class="welcome-note">Hecho especialmente para ti ♡</span>
      </div>
    </section>

    <main id="contenido">
      <section class="page section birthday-cover cream">
        <div class="section-inner">
          <div class="reveal">
            <span class="eyebrow">HOY CELEBRAMOS ALGO MARAVILLOSO</span>

            <h2 class="display-title">
              El mundo es<br />
              más bonito<br />
              <em>desde que existes.</em>
            </h2>
          </div>

          <div class="polaroid portada-polaroid reveal">
            <img
              src="/fotos/portada.jpg"
              alt="Mi persona favorita"
              loading="lazy"
            />
            <span>Mi persona favorita ♡</span>
          </div>

          <p class="body-copy reveal">
            Hoy es tu cumpleaños, y aunque no exista un regalo capaz de
            demostrarte todo lo que significas para mí, quise crear este pequeño
            rincón para recordártelo.
          </p>

          <p class="handwritten reveal">Para ti, con todo mi amor.</p>
        </div>
      </section>

      <section class="page section celebration teal">
        <div class="section-inner reveal">
          <span class="eyebrow light">HOY EL UNIVERSO CELEBRA</span>
          <div class="sparkle">✦</div>

          <h2 class="display-title light-title">
            Qué suerte<br />
            tiene el mundo<br />
            <em>de tenerte.</em>
          </h2>

          <p class="body-copy light-copy">
            Hoy no es un día cualquiera. Hoy celebramos tu sonrisa, tus sueños,
            tu forma de ser y todas esas cosas que te hacen tan especial.
          </p>

          <div class="birthday-decoration">✧ ♡ ✧</div>
          <p class="script-message">Sigue brillando, mi niña bonita.</p>
        </div>
      </section>

      <section class="page section memories cream">
        <div class="section-inner">
          <div class="reveal">
            <span class="eyebrow">UN POQUITO DE NOSOTROS</span>

            <h2 class="section-title">
              Nuestros<br />
              <em>recuerdos</em>
            </h2>

            <p class="section-description">
              Hay fotografías que no solo guardan momentos, también guardan
              sentimientos.
            </p>
          </div>

          <div class="memory-collage">
            {
              recuerdos.map((item, index) => (
                <div class={`polaroid memory-photo photo-${index + 1} reveal`}>
                  <img src={item.foto} alt={item.texto} loading="lazy" />
                  <span>{item.texto}</span>
                </div>
              ))
            }
          </div>

          <p class="quote reveal">
            Si pudiera volver a vivir alguno de estos momentos, lo haría mil
            veces, siempre contigo.
          </p>
        </div>
      </section>

      <section class="page section wishes soft-teal">
        <div class="section-inner">
          <div class="reveal">
            <span class="eyebrow">EN ESTE NUEVO AÑO DE VIDA</span>

            <h2 class="section-title">
              Mis deseos<br />
              <em>para ti.</em>
            </h2>

            <p class="section-description">
              Si pudiera pedirle tres cosas al universo para ti, serían estas...
            </p>
          </div>

          <div class="wish-list">
            {
              deseos.map((deseo, index) => (
                <article class="wish-card reveal">
                  <span class="wish-number">0{index + 1}</span>
                  <div class="wish-content">
                    <h3>{deseo.titulo}</h3>
                    <p>{deseo.texto}</p>
                  </div>
                  <span class="wish-heart">♡</span>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="page photo-break">
        <img
          src="/fotos/recuerdo-2.jpg"
          alt="Uno de nuestros recuerdos favoritos"
          loading="lazy"
        />
        <div class="photo-break-overlay"></div>

        <div class="photo-break-content reveal">
          <span>DE TODOS LOS LUGARES</span>

          <h2>
            Mi favorito<br />
            siempre será<br />
            <em>a tu lado.</em>
          </h2>
        </div>
      </section>

      <section class="page section reasons cream">
        <div class="section-inner">
          <div class="reveal">
            <span class="eyebrow">HAY TANTAS COSAS BONITAS</span>

            <h2 class="section-title">
              Cosas que<br />
              <em>amo de ti</em>
            </h2>

            <p class="section-description">
              Toca cada notita para descubrir algunas de mis razones.
            </p>
          </div>

          <div class="reason-list">
            {
              razones.map((razon, index) => (
                <button
                  class="reason-card reveal"
                  type="button"
                  aria-expanded="false"
                >
                  <span class="reason-heading">
                    <span class="reason-index">0{index + 1}</span>
                    <span>Una razón más...</span>
                    <span class="reason-plus">+</span>
                  </span>

                  <span class="reason-content">
                    <span class="reason-content-inner">
                      <span class="reason-text">{razon}</span>
                    </span>
                  </span>
                </button>
              ))
            }
          </div>

          <p class="handwritten reveal">Y me faltan muchísimas más...</p>
        </div>
      </section>

      <section class="page section album teal">
        <div class="section-inner reveal">
          <span class="eyebrow light">NUESTRO PEQUEÑO ÁLBUM</span>

          <h2 class="section-title light-title">
            Momentos<br />
            <em>que guardo aquí</em>
          </h2>

          <p class="section-description light-copy">
            Algunas fotografías son demasiado bonitas como para quedarse
            solamente en la galería.
          </p>
        </div>

        <div class="album-scroll">
          {
            galeriaExtra.map((item, index) => (
              <div class={`album-card album-${index % 3}`}>
                <div class="polaroid">
                  <img src={item.foto} alt={item.texto} loading="lazy" />
                  <span>{item.texto}</span>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="page section letter-section cream">
        <div class="section-inner">
          <div class="reveal">
            <span class="eyebrow">HAY ALGO QUE QUIERO DECIRTE</span>

            <h2 class="section-title">
              Una carta<br />
              <em>para ti ♡</em>
            </h2>

            <p class="section-description">
              Algunas cosas son más fáciles de escribir cuando salen del
              corazón.
            </p>
          </div>

          <div class="envelope-area reveal">
            <button
              id="openLetter"
              class="envelope-button"
              type="button"
              aria-label="Abrir carta de cumpleaños"
              aria-haspopup="dialog"
            >
              <div class="envelope">
                <div class="envelope-back"></div>
                <div class="envelope-paper">Para mi amor ♡</div>
                <div class="envelope-front"></div>
                <div class="envelope-flap"></div>
                <div class="envelope-seal">♡</div>
              </div>
            </button>

            <p class="envelope-instruction">
              Toca el sobre para abrir mi carta
            </p>
          </div>

          <p class="handwritten reveal">Hay palabras que son solo para ti.</p>
        </div>
      </section>

      <section class="page section cake-section soft-teal">
        <div class="section-inner reveal">
          <span class="eyebrow">PORQUE HOY ES TU DÍA</span>

          <h2 class="section-title">
            Es momento de<br />
            <em>pedir un deseo.</em>
          </h2>

          <p class="section-description">
            Cierra tus ojitos, piensa en algo muy bonito y apaga las velitas.
          </p>

          <div class="cake-scene" id="cakeScene">
            <div class="candles">
              <div class="candle"><span class="flame"></span></div>
              <div class="candle"><span class="flame"></span></div>
              <div class="candle"><span class="flame"></span></div>
            </div>

            <div class="cake-top"></div>

            <div class="cake-body">
              <div class="cake-icing"></div>
              <span>♡</span>
            </div>

            <div class="cake-plate"></div>
          </div>

          <button id="blowCandles" class="btn btn-teal" type="button">
            Soplar las velitas ♡
          </button>

          <p id="wishMessage" class="wish-message" aria-live="polite">
            Que todos tus sueños se hagan realidad.
          </p>
        </div>
      </section>

      <section class="page section garden-section">
        <div class="garden-decorations" aria-hidden="true">
          <span>✿</span>
          <span>✧</span>
          <span>❀</span>
          <span>✿</span>
          <span>✧</span>
          <span>❀</span>
          <span>✿</span>
        </div>

        <div class="section-inner reveal">
          <span class="eyebrow light">ENTRE TODOS LOS LUGARES</span>
          <div class="garden-symbol">✿</div>

          <h2 class="section-title light-title">
            Mi jardín<br />
            <em>favorito eres tú.</em>
          </h2>

          <p class="section-description light-copy">
            Si pudiera crear un lugar al que siempre quisiera volver, estaría
            lleno de nuestras risas, nuestros abrazos y todos esos momentos que
            hacen tan bonita la vida contigo.
          </p>

          <div class="polaroid garden-polaroid">
            <img
              src="/fotos/historia-3.jpg"
              alt="Nuestro jardín de recuerdos"
              loading="lazy"
            />
            <span>Donde florece nuestro amor ♡</span>
          </div>

          <p class="garden-quote">
            Ojalá la vida nos regale muchos años más para seguir floreciendo
            juntos.
          </p>

          <div class="garden-footer">✿ ♡ ✿</div>
        </div>
      </section>

      <section class="page section surprise-section cream">
        <div class="section-inner reveal">
          <span class="eyebrow">UNA ÚLTIMA COSITA</span>

          <h2 class="section-title">
            Todavía tengo<br />
            <em>algo para ti...</em>
          </h2>

          <p class="section-description">
            Porque tu cumpleaños merece una última sorpresa.
          </p>

          <div id="gift" class="gift">
            <div class="gift-bow">
              <div></div>
              <div></div>
            </div>

            <div class="gift-lid"></div>
            <div class="gift-box"></div>

            <div class="gift-sparkles" aria-hidden="true">
              <span>✦</span>
              <span>♡</span>
              <span>✧</span>
              <span>✿</span>
              <span>♡</span>
            </div>
          </div>

          <button id="openGift" class="btn btn-teal" type="button">
            Ver mi sorpresa
          </button>

          <p id="giftHint" class="gift-hint" aria-live="polite"></p>
        </div>
      </section>

      <section class="page section ending teal">
        <div class="section-inner reveal">
          <h2 class="display-title light-title">
            Gracias<br />
            <em>por existir.</em>
          </h2>

          <p class="body-copy light-copy">
            Gracias por tu amor, tu compañía, tus ideas, tus locuras y por ser
            exactamente tú.
          </p>

          <div class="polaroid final-photo">
            <img
              src="/fotos/final.jpg"
              alt="Nuestro recuerdo final"
              loading="lazy"
            />
            <span>Te amo muchísimo ♡</span>
          </div>

          <h2 class="ending-title">
            Feliz cumpleaños,<br />
            mi amor.
          </h2>

          <div class="ending-signature">
            Con todo mi amor,<br />
            para ti. ♡
          </div>

          <button id="replayBtn" class="replay-button" type="button">
            Volver al comienzo ↑
          </button>

          <span class="ending-footer">HECHO CON AMOR, SOLO PARA TI</span>
        </div>
      </section>
    </main>

    <div
      id="letterModal"
      class="letter-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="letterTitle"
      hidden
    >
      <div class="letter-modal-header">
        <span>UNA CARTA PARA TI ♡</span>

        <button id="closeLetter" type="button" aria-label="Cerrar carta">
          ✕
        </button>
      </div>

      <div class="letter-modal-scroll">
        <div class="letter-paper">
          <span class="letter-top">PARA MI PERSONA FAVORITA</span>

          <h3 id="letterTitle">Feliz cumpleaños, amor</h3>

          {carta.map((parrafo) => <p>{parrafo}</p>)}

          <div class="letter-signature">
            Con todo mi amor,<br />
            Tu persona favorita ♡
          </div>
        </div>
      </div>
    </div>

    <div
      id="giftModal"
      class="gift-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="giftModalTitle"
      hidden
    >
      <div class="gift-modal-panel">
        <button
          id="closeGiftModal"
          class="modal-close"
          type="button"
          aria-label="Cerrar sorpresa"
        >
          ✕
        </button>

        <div class="gift-modal-symbol">♡</div>

        <h2 id="giftModalTitle">
          Mi regalo favorito<br />
          <em>es tenerte en mi vida.</em>
        </h2>

        <p>
          Espero que este sea apenas uno de los muchos cumpleaños que podamos
          seguir celebrando juntos.
        </p>

        <p>
          Que nunca te falten motivos para sonreír, ni personas que te recuerden
          lo increíble que eres.
        </p>

        <span class="gift-modal-love">Te amo ♡</span>
      </div>
    </div>

    <div id="heartsContainer" aria-hidden="true"></div>

    <script>
      const audio = document.querySelector<HTMLAudioElement>("#musica");
      const startBtn = document.querySelector<HTMLButtonElement>("#startBtn");
      const pages = Array.from(document.querySelectorAll<HTMLElement>(".page"));

      let currentPage = 0;
      let isNavigating = false;
      let navigationTimer: number | undefined;
      let musicaIniciada = false;

      async function iniciarMusica() {
        if (!audio || musicaIniciada) return;

        try {
          await audio.play();
          musicaIniciada = true;

          document.removeEventListener("touchstart", iniciarMusica);
          document.removeEventListener("pointerdown", iniciarMusica);
          document.removeEventListener("keydown", iniciarMusica);
        } catch {}
      }

      iniciarMusica();

      document.addEventListener("touchstart", iniciarMusica, { passive: true });
      document.addEventListener("pointerdown", iniciarMusica);
      document.addEventListener("keydown", iniciarMusica);

      const openLetter =
        document.querySelector<HTMLButtonElement>("#openLetter");
      const closeLetter =
        document.querySelector<HTMLButtonElement>("#closeLetter");
      const letterModal = document.querySelector<HTMLElement>("#letterModal");
      const giftModal = document.querySelector<HTMLElement>("#giftModal");
      const closeGiftModal =
        document.querySelector<HTMLButtonElement>("#closeGiftModal");

      function modalAbierto() {
        return Boolean(
          (letterModal && !letterModal.hidden) ||
            (giftModal && !giftModal.hidden),
        );
      }

      function revelarPagina(page: HTMLElement) {
        page
          .querySelectorAll<HTMLElement>(".reveal")
          .forEach((element, index) => {
            const delay = Math.min(index * 75, 300);

            window.setTimeout(() => {
              element.classList.add("visible");
            }, delay);
          });
      }

      function mostrarPagina(index: number, instant = false) {
        if (index < 0 || index >= pages.length) return;
        if (isNavigating && !instant) return;
        if (modalAbierto()) return;

        isNavigating = true;
        currentPage = index;

        pages.forEach((page, i) => {
          const activa = i === currentPage;

          page.classList.toggle("active-page", activa);
          page.setAttribute("aria-hidden", String(!activa));
          page.inert = !activa;

          page.style.transitionDuration = instant ? "0ms" : "650ms";
          page.style.transform = `translate3d(0, ${(i - currentPage) * 100}%, 0)`;
        });

        revelarPagina(pages[currentPage]);

        clearTimeout(navigationTimer);

        navigationTimer = window.setTimeout(
          () => {
            isNavigating = false;
          },
          instant ? 0 : 680,
        );
      }

      function siguientePagina() {
        mostrarPagina(currentPage + 1);
      }

      function paginaAnterior() {
        mostrarPagina(currentPage - 1);
      }

      let touchStartY = 0;
      let touchStartX = 0;
      let touchActive = false;
      let horizontalSwipe = false;

      document.addEventListener(
        "touchstart",
        (event) => {
          if (modalAbierto() || event.touches.length !== 1) return;

          touchStartY = event.touches[0].clientY;
          touchStartX = event.touches[0].clientX;

          touchActive = true;
          horizontalSwipe = false;
        },
        { passive: true },
      );

      document.addEventListener(
        "touchmove",
        (event) => {
          if (!touchActive || modalAbierto() || event.touches.length !== 1) {
            return;
          }

          const deltaY = event.touches[0].clientY - touchStartY;
          const deltaX = event.touches[0].clientX - touchStartX;
          const target = event.target as Element;
          const album = target.closest?.(".album-scroll");

          if (album && Math.abs(deltaX) > Math.abs(deltaY)) {
            horizontalSwipe = true;
            return;
          }

          if (horizontalSwipe) return;

          if (Math.abs(deltaY) > Math.abs(deltaX)) {
            event.preventDefault();
          }
        },
        { passive: false },
      );

      document.addEventListener(
        "touchend",
        (event) => {
          if (!touchActive || modalAbierto()) return;

          touchActive = false;

          if (horizontalSwipe || !event.changedTouches.length) return;

          const deltaY = event.changedTouches[0].clientY - touchStartY;
          const deltaX = event.changedTouches[0].clientX - touchStartX;

          if (Math.abs(deltaX) > Math.abs(deltaY)) return;
          if (Math.abs(deltaY) < 45) return;

          if (deltaY < 0) {
            siguientePagina();
          } else {
            paginaAnterior();
          }
        },
        { passive: true },
      );

      document.addEventListener("touchcancel", () => {
        touchActive = false;
        horizontalSwipe = false;
      });

      let wheelAccumulator = 0;
      let wheelResetTimer: number | undefined;

      document.addEventListener(
        "wheel",
        (event) => {
          if (modalAbierto()) return;

          const target = event.target as Element;
          const album = target.closest?.(".album-scroll");

          if (album && Math.abs(event.deltaX) > Math.abs(event.deltaY)) {
            return;
          }

          event.preventDefault();

          if (isNavigating) return;

          wheelAccumulator += event.deltaY;
          clearTimeout(wheelResetTimer);

          wheelResetTimer = window.setTimeout(() => {
            wheelAccumulator = 0;
          }, 150);

          if (Math.abs(wheelAccumulator) >= 35) {
            if (wheelAccumulator > 0) {
              siguientePagina();
            } else {
              paginaAnterior();
            }

            wheelAccumulator = 0;
          }
        },
        { passive: false },
      );

      document.addEventListener("keydown", (event) => {
        if (modalAbierto()) {
          if (event.key === "Escape") cerrarModales();
          return;
        }

        if (event.key === "ArrowDown" || event.key === "PageDown") {
          event.preventDefault();
          siguientePagina();
        }

        if (event.key === "ArrowUp" || event.key === "PageUp") {
          event.preventDefault();
          paginaAnterior();
        }

        if (event.key === "Home") {
          event.preventDefault();
          mostrarPagina(0);
        }

        if (event.key === "End") {
          event.preventDefault();
          mostrarPagina(pages.length - 1);
        }
      });

      startBtn?.addEventListener("click", () => {
        iniciarMusica();
        mostrarPagina(1);
      });

      document.querySelector("#replayBtn")?.addEventListener("click", () => {
        mostrarPagina(0);
      });

      const reasonCards =
        document.querySelectorAll<HTMLButtonElement>(".reason-card");

      reasonCards.forEach((card) => {
        card.addEventListener("click", () => {
          const estabaAbierta = card.classList.contains("active");

          reasonCards.forEach((other) => {
            if (other !== card) {
              other.classList.remove("active");
              other.setAttribute("aria-expanded", "false");
            }
          });

          card.classList.toggle("active", !estabaAbierta);
          card.setAttribute("aria-expanded", String(!estabaAbierta));
        });
      });

      const modalTimers = new WeakMap<HTMLElement, number>();

      function abrirModal(modal: HTMLElement) {
        const timer = modalTimers.get(modal);
        if (timer !== undefined) clearTimeout(timer);

        modal.hidden = false;
        document.body.classList.add("modal-open");

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            modal.classList.add("is-open");
          });
        });
      }

      function cerrarModal(
        modal: HTMLElement,
        devolverFoco?: HTMLElement | null,
      ) {
        modal.classList.remove("is-open");

        const timer = window.setTimeout(() => {
          modal.hidden = true;

          if (!modalAbierto()) {
            document.body.classList.remove("modal-open");
          }

          devolverFoco?.focus({ preventScroll: true });
        }, 380);

        modalTimers.set(modal, timer);
      }

      function cerrarModales() {
        if (letterModal && !letterModal.hidden) {
          cerrarModal(letterModal, openLetter);
        }

        if (giftModal && !giftModal.hidden) {
          cerrarModal(giftModal);
        }
      }

      openLetter?.addEventListener("click", () => {
        if (!letterModal) return;

        abrirModal(letterModal);

        window.setTimeout(() => {
          closeLetter?.focus({ preventScroll: true });
        }, 150);
      });

      closeLetter?.addEventListener("click", () => {
        if (letterModal) cerrarModal(letterModal, openLetter);
      });

      closeGiftModal?.addEventListener("click", () => {
        if (giftModal) cerrarModal(giftModal);
      });

      function createHearts(amount = 25) {
        const container = document.querySelector("#heartsContainer");
        if (!container) return;

        const simbolos = ["♡", "♥", "✿", "✦"];

        for (let i = 0; i < amount; i++) {
          const heart = document.createElement("span");

          heart.className = "floating-heart";
          heart.textContent =
            simbolos[Math.floor(Math.random() * simbolos.length)];

          heart.style.left = `${Math.random() * 100}%`;
          heart.style.animationDelay = `${Math.random() * 0.8}s`;
          heart.style.animationDuration = `${3 + Math.random() * 3}s`;
          heart.style.fontSize = `${15 + Math.random() * 23}px`;

          container.appendChild(heart);

          window.setTimeout(() => {
            heart.remove();
          }, 7000);
        }
      }

      const blowCandles =
        document.querySelector<HTMLButtonElement>("#blowCandles");

      blowCandles?.addEventListener("click", () => {
        document.querySelector("#cakeScene")?.classList.add("candles-out");
        document.querySelector("#wishMessage")?.classList.add("show");

        blowCandles.textContent = "¡Feliz cumpleaños! ♡";
        blowCandles.disabled = true;

        createHearts(35);
      });

      const openGift = document.querySelector<HTMLButtonElement>("#openGift");
      const gift = document.querySelector<HTMLElement>("#gift");

      let regaloAbierto = false;

      openGift?.addEventListener("click", () => {
        if (regaloAbierto) return;

        regaloAbierto = true;

        openGift.disabled = true;
        openGift.classList.add("is-disappearing");
        gift?.classList.add("opening");

        window.setTimeout(() => {
          gift?.classList.add("opened");
          createHearts(45);

          const hint = document.querySelector<HTMLElement>("#giftHint");

          if (hint) {
            hint.textContent = "Una sorpresita para ti ♡";
            hint.classList.add("show");
          }
        }, 550);

        window.setTimeout(() => {
          if (giftModal) {
            abrirModal(giftModal);

            window.setTimeout(() => {
              closeGiftModal?.focus({ preventScroll: true });
            }, 150);
          }
        }, 1250);
      });

      mostrarPagina(0, true);
    </script>
  </body>
</html>

